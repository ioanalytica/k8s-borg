# syntax=docker/dockerfile:1
#
# k8s-borg-ui — self-built, hermetic Borg UI SERVER image.
#
# Unlike upstream borg-ui/Dockerfile (which COPYs a frontend bundle built
# out-of-band in CI), this builds the frontend INSIDE the image, so
# `docker build` alone is fully reproducible. The frontend stage is pinned to
# $BUILDPLATFORM, so it is built ONCE even for a multi-arch image.
#
# Build context = the borg-ui submodule:
#   built by ./docker-build-server.sh
#   docker buildx build -f Dockerfile-server borg-ui
#   ->  ghcr.io/ioanalytica/k8s-borg-ui
#
# hadolint: the builder stages mirror upstream; pinning every apt package
# (DL3008) / the pip bootstrap (DL3013) and dropping recommends (DL3015) would
# diverge from what upstream builds & tests. --no-cache-dir (DL3042) is fixed.
# hadolint global ignore=DL3008,DL3013,DL3015

ARG BASE_IMAGE=ghcr.io/ioanalytica/k8s-borg-ui-runtime-base:runtime-borg1-1.4.4-borg2-2.0.0b21-r4

# --- frontend (Vite) — built once on the builder arch, then copied in --------
FROM --platform=$BUILDPLATFORM node:22-slim AS frontend-builder
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build
# vite.config.ts sets outDir 'build' -> /frontend/build

# --- managed agent package — served to enrolling nodes ----------------------
# An enrolling node installs the agent belonging to this server rather than
# whatever upstream's default branch holds, which matters here because our
# deployment runs ahead of it. The agent is pure Python, so one py3-none-any
# wheel covers every target platform.
FROM python:3.12-slim AS agent-builder
WORKDIR /agent-src
COPY pyproject.toml ./
COPY agent/ ./agent/
RUN pip install --no-cache-dir build && \
    python -m build --wheel --outdir /agent-dist

# --- backend python dependencies --------------------------------------------
FROM python:3.10-slim AS backend-builder
WORKDIR /app
RUN apt-get update && apt-get install -y \
    gcc g++ make python3-dev libffi-dev libssl-dev build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# --- production -------------------------------------------------------------
FROM ${BASE_IMAGE} AS production
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}

LABEL org.opencontainers.image.title="k8s-borg-ui (Borg Web UI, self-built)"
LABEL org.opencontainers.image.description="Hermetic Borg UI server image for k8s-borg"
LABEL org.opencontainers.image.source="https://github.com/ioanalytica/k8s-borg"
LABEL org.opencontainers.image.version="${APP_VERSION}"

WORKDIR /app

# Python dependencies built in the backend stage
COPY --from=backend-builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=backend-builder /usr/local/bin /usr/local/bin

# Application code first, then the hermetically-built frontend bundle on top
COPY app/ ./app/
COPY VERSION ./VERSION
COPY --from=frontend-builder /frontend/build ./app/static/

# Agent wheel, served at /agent/package/<filename> to enrolling nodes.
COPY --from=agent-builder /agent-dist/ /opt/borg-ui/agent-dist/

RUN chown -R borg:borg /app /data /backups /var/log/borg /etc/borg && \
    chmod -R 755 /app /data /backups /var/log/borg /etc/borg

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONPATH=/app
ENV DATA_DIR=/data
# No DATABASE_URL default: the app derives sqlite:///$DATA_DIR/borg.db itself
# when none is set. A default here would always win over DB_HOST (DATABASE_URL
# takes precedence), so the Postgres switch (borgUI.postgres) could never take
# effect -- the pod would keep running on SQLite with every DB_* variable set.
ENV BORG_BACKUP_PATH=/backups
ENV BORG_CACHE_DIR=/home/borg/.cache/borg
ENV ENABLE_CRON_BACKUPS=false
ENV PORT=8081
# License phone-home — upstream defaults; override in the k8s deployment
# (ENABLE_STARTUP_LICENSE_SYNC=false and/or empty ACTIVATION_SERVICE_URL).
ENV ACTIVATION_SERVICE_URL=https://license.borgui.com
ENV ENABLE_STARTUP_LICENSE_SYNC=true

EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8081}/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
