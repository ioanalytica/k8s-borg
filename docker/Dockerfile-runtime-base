# syntax=docker/dockerfile:1
#
# k8s-borg-ui runtime base — self-built, slim (multi-stage).
#
# Same versions/recipe as upstream borg-ui/Dockerfile.runtime-base
# (karanhudia/borg-ui), pinned via docker/runtime-base.env — BUT built in two
# stages so the compile toolchain (build-essential + *-dev headers, ~350-400 MB)
# never lands in the runtime image. Ships Borg 1.x + Borg 2.x (borg2 in its own
# venv), the `borg` user and the runtime dirs the server expects.
#
#   built by ./docker-build-runtime-base.sh
#   ->  ghcr.io/ioanalytica/k8s-borg-ui-runtime-base
#
# hadolint: pinning apt (DL3008) / the pip bootstrap (DL3013) or splitting RUNs
# (DL3059) would diverge from upstream's tested recipe.
# hadolint global ignore=DL3008,DL3013,DL3015,DL3059

# --- builder: compile the Borg wheels (needs the toolchain + -dev headers) ----
FROM python:3.10-slim AS builder

ARG BORG1_VERSION=1.4.4
ARG BORG2_VERSION=2.0.0b21
ARG BORGSTORE_VERSION=0.4.1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    pkg-config \
    libacl1-dev \
    libssl-dev \
    liblz4-dev \
    libzstd-dev \
    libxxhash-dev \
    libfuse3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pyfuse3 "borgbackup[fuse]==${BORG1_VERSION}"
RUN python3 -m venv /opt/borg2-venv && \
    /opt/borg2-venv/bin/pip install --no-cache-dir pyfuse3 "borgbackup[fuse]==${BORG2_VERSION}" "borgstore[rclone]==${BORGSTORE_VERSION}"

# --- runtime: slim image, no compilers — only runtime libs + tools ------------
FROM python:3.10-slim AS runtime-base

ARG BORG1_VERSION=1.4.4
ARG BORG2_VERSION=2.0.0b21
ENV BORG1_VERSION=${BORG1_VERSION}
ENV BORG2_VERSION=${BORG2_VERSION}

LABEL org.opencontainers.image.title="k8s-borg-ui runtime base"
LABEL org.opencontainers.image.description="Self-built slim Borg UI runtime base (Borg 1.x + Borg 2.x)"
LABEL org.opencontainers.image.source="https://github.com/ioanalytica/k8s-borg"

WORKDIR /app

# Runtime packages only: the shared libs Borg links against (no -dev headers),
# FUSE, and the operational tools. No gcc/g++/toolchain here.
RUN apt-get update && apt-get install -y --no-install-recommends \
    cron \
    curl \
    wget \
    gnupg \
    gosu \
    sudo \
    libacl1 \
    liblz4-1 \
    libzstd1 \
    libxxhash0 \
    libssl3t64 \
    libfuse3-4 \
    fuse3 \
    rsync \
    rclone \
    btrfs-progs \
    openssh-client \
    sshfs \
    htop \
    iotop \
    net-tools \
    iputils-ping \
    tree \
    ncdu \
    sshpass \
    && rm -rf /var/lib/apt/lists/*

# Borg itself, compiled in the builder — copy the artifacts, not the toolchain.
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /opt/borg2-venv /opt/borg2-venv
RUN ln -sf /opt/borg2-venv/bin/borg /usr/local/bin/borg2

RUN mkdir -p \
    /data \
    /data/ssh_keys \
    /data/borg_keys \
    /data/logs \
    /data/config \
    /backups \
    /var/log/borg \
    /etc/borg

RUN groupadd -g 1001 borg && \
    useradd -m -u 1001 -g 1001 -s /bin/bash borg && \
    usermod -a -G sudo borg && \
    groupadd -f fuse && \
    usermod -a -G fuse borg && \
    echo "borg ALL=(ALL) NOPASSWD: /usr/bin/borg, /usr/bin/crontab, /usr/bin/apt-get" >> /etc/sudoers && \
    sed -i 's/^#user_allow_other/user_allow_other/' /etc/fuse.conf

RUN mkdir -p /home/borg/.ssh /home/borg/.cache/borg /etc/cron.d && \
    chown -R borg:borg /app /data /backups /var/log/borg /etc/borg /home/borg/.ssh /home/borg/.cache /etc/cron.d && \
    chmod -R 755 /app /data /backups /var/log/borg /etc/borg && \
    chmod 700 /home/borg/.ssh /home/borg/.cache/borg
