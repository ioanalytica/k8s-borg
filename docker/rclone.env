# rclone in the agent image: the official static binary from
# downloads.rclone.org, checked against these SHA-256 sums. They are the
# release's SHA256SUMS, whose PGP signature (rclone release key
# FBF737ECE9F8AB18604BD2AC93935E02FF3B54FA) was verified when they were copied.
#
# docker/Dockerfile repeats them as ARG defaults (tests/rclone-pin.bats keeps
# the two equal) and installs this build instead of Alpine's package, which
# lags behind upstream fixes (Alpine 3.24: 1.74.1, open CVE-2026-88017/88018/88044).
# The UI image's rclone is borg-ui's: borg-ui/docker/runtime-base.env.
RCLONE_VERSION=1.75.2
RCLONE_SHA256_AMD64=349ac8fba6ff65d6247043f1750cdcb518ec5d500ef91463a10d37c0ccdf3702
RCLONE_SHA256_ARM64=7e1e8d69654941b7b7df84ee74c5f7fb09cce7d5496947fb7bf16b55ff427d10
