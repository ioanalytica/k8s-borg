#!/usr/bin/env bash
#
# Register this node's own Borg repository (BORG_REPO) with the Borg UI server
# under the agent's name, bound to this node's agent (executor_type=agent).
# Idempotent: a record that already has the path BORG_REPO is left as is.
#
# A record with the agent's name and another path (the repository base of the
# release changed) is moved to BORG_REPO and resynced, when it is this node's
# own record: bound to this node's agent, of the same Borg major and encryption
# mode, and BORG_REPO is a remote ssh:// URL. Borg UI checks a changed path itself, on the server,
# and initializes a location it finds empty there, so a local path is not
# handed to it. Anything else that does not fit together ends non-zero with
# both paths, rather than letting the pod start on a stale record.
#
# Standalone command — also called by run-agent.sh. Auth (borgui-common.sh) is
# PAT-first: BORG_UI_ADMIN_PAT when it works, else BORG_UI_ADMIN_USER/PASS; a
# parent may share a resolved token via BORG_UI_JWT to skip re-auth.
#
#   BORG_UI_SERVER      e.g. http://k8s-borg-ui.borg.svc.cluster.local:8081
#   BORG_REPO           the repository path/URL to register
#   BORG_VERSION        borg version for this repo: 1 or 2
#   BORG_PASSPHRASE     repo passphrase (stored server-side; agent runs borg)
#   BORG_UI_AGENT_NAME  optional; repo/agent name. Default: pod hostname.
#   BORG_ENCRYPTION     optional; the mode borg-init created the repository with,
#                       default per Borg major. Recorded under Borg UI's name for
#                       it (borg-encryption.sh, shared with borg-init).
#   BORG_COMPRESSION    optional, default "auto,lz4"
#   BORG_UI_ADMIN_PAT   preferred admin credential (bootstrap-minted PAT)
#   BORG_UI_ADMIN_USER  admin user   (fallback when no working PAT)
#   BORG_UI_ADMIN_PASS  admin password (fallback when no working PAT)
#   BORG_UI_JWT         optional; a pre-resolved token shared by a parent
#
set -euo pipefail

# shellcheck source=../lib/borgui-common.sh
. "${BORG_LIB_DIR:-/usr/local/lib}/borgui-common.sh"
# shellcheck source=../lib/borg-encryption.sh
. "${BORG_LIB_DIR:-/usr/local/lib}/borg-encryption.sh"

borgui_require_server
: "${BORG_REPO:?set BORG_REPO to the repository path/URL to register}"
: "${BORG_VERSION:?set BORG_VERSION to 1 or 2}"

: "${REPO_NAME:=${BORG_UI_AGENT_NAME:-$(hostname)}}"
# Borg UI's import stores the mode without checking it, so a mode borg-init
# refuses stops here, before the server is asked.
borg_encryption "${BORG_VERSION}" || borgui_die "cannot record the repository's encryption mode"
# shellcheck disable=SC2154  # borg_enc_name is set by borg_encryption
enc="${borg_enc_name}"
comp="${BORG_COMPRESSION:-auto,lz4}"

# admin bearer token (PAT-first; reuses BORG_UI_JWT if a parent set it)
jwt=$(borgui_bearer) || borgui_die "could not authenticate to Borg UI"

# the record with this node's name and the record with its path, as
# id, name, path, Borg major, agent id, encryption mode ("unknown" is no mode;
# fields separated by \037, so that an empty field stays a field)
records=$(borgui_api "$jwt" GET /api/repositories/ \
  | REPO_NAME="${REPO_NAME}" BORG_REPO="${BORG_REPO}" python3 -c '
import sys, json, os
data = json.load(sys.stdin)
repos = data.get("repositories", []) if isinstance(data, dict) else data
name, path = os.environ["REPO_NAME"], os.environ["BORG_REPO"]
def fields(r):
    if r is None:
        return [""] * 6
    aid = r.get("agent_machine_id")
    return [str(r["id"]), r.get("name") or "", r.get("path") or "",
            str(r.get("borg_version") or 1), "" if aid in (None, "") else str(aid),
            "" if str(r.get("encryption") or "").lower() == "unknown" else r.get("encryption") or ""]
by_name = next((r for r in repos if r.get("name") == name), None)
by_path = next((r for r in repos if r.get("path") == path), None)
print("\037".join(fields(by_name) + fields(by_path)))') \
  || borgui_die "could not list repositories"
IFS=$'\037' read -r n_id _ n_path n_major n_agent n_enc p_id p_name _ _ _ _ <<<"$records"

if [ -n "$p_id" ]; then
  if [ -z "$n_id" ] || [ "$n_id" = "$p_id" ]; then
    echo "Repository '${REPO_NAME}' already registered — nothing to do."
    exit 0
  fi
  borgui_die "${BORG_REPO} is registered as '${p_name}' (id ${p_id}), while the record '${REPO_NAME}' (id ${n_id}) points at ${n_path} — resolve the two records in Borg UI."
fi

# resolve this node's agent id (newest queueable; borgui-common.sh handles the
# duplicate/revoked edge cases). A missing/non-queueable agent means the node
# isn't enrolled server-side.
agent_id=$(borgui_agent_id "$jwt" "$REPO_NAME") || borgui_die "could not list agents"

if [ -z "$agent_id" ]; then
  borgui_die "no queueable agent named '${REPO_NAME}' — enroll the node first."
fi

if [ -n "$n_id" ]; then
  moving="the record '${REPO_NAME}' (id ${n_id}) points at ${n_path}, this node's repository is ${BORG_REPO}"
  [ "$n_agent" = "$agent_id" ] \
    || borgui_die "${moving}; the record belongs to ${n_agent:+agent ${n_agent}}${n_agent:-no agent}, not to this node's agent ${agent_id} — not moved."
  [ "$n_major" = "$BORG_VERSION" ] \
    || borgui_die "${moving}; the record is a Borg ${n_major} repository, this node runs Borg ${BORG_VERSION}, and a record keeps its Borg major — not moved."
  # The move sends only the path, so the record would keep its mode while
  # borg-init created the repository at BORG_REPO with ${enc}. A record without
  # a mode has nothing to compare.
  if [ -n "$n_enc" ] && [ "$n_enc" != "$enc" ]; then
    mismatch="${moving}; the record says encryption '${n_enc}', the repository at ${BORG_REPO} was created as '${enc}' (BORG_ENCRYPTION), and a move keeps the record's mode — not moved. Created anew: remove the record in Borg UI without deleting data, so that the pod registers the repository with its mode."
    # Only a mode this node could create is worth setting; a record from
    # before the per-major names may carry one it cannot.
    if borg_encryption_creates "$BORG_VERSION" "$n_enc"; then
      mismatch+=" A copy of the old repository: set BORG_ENCRYPTION to '${n_enc}'."
    else
      mismatch+=" '${n_enc}' is no Borg ${BORG_VERSION} mode this node can create, so the record is wrong either way."
    fi
    borgui_die "$mismatch"
  fi
  case "$BORG_REPO" in
    ssh://*) ;;
    *) borgui_die "${moving}; Borg UI would check a local path on its own server, not on this node — change the record in Borg UI." ;;
  esac

  echo "Repository '${REPO_NAME}' (id ${n_id}) moves: ${n_path} -> ${BORG_REPO}"
  # only the path: Borg UI refuses keys it does not apply
  body=$(BORG_REPO="${BORG_REPO}" python3 -c 'import json, os; print(json.dumps({"path": os.environ["BORG_REPO"]}))')
  resp=$(curl -sS -X PUT "${BORG_UI_SERVER}/api/repositories/${n_id}" \
           -H "Authorization: Bearer ${jwt}" -H "Content-Type: application/json" \
           -d "${body}" -w '\n%{http_code}') \
    || borgui_die "could not reach Borg UI to move the record"
  code="${resp##*$'\n'}"
  [ "$code" = "200" ] \
    || borgui_die "Borg UI refused to move the record (HTTP ${code}): ${resp%$'\n'*}"
  # the archives Borg UI lists for the record still come from the old path
  borgui_api "$jwt" POST "/api/repositories/${n_id}/resync" >/dev/null \
    || echo "WARN: resync of '${REPO_NAME}' could not be requested — Borg UI catches up on its next reconcile run." >&2
  echo "Repository '${REPO_NAME}' (id ${n_id}) now at ${BORG_REPO}."
  exit 0
fi

# build the import payload (python3 handles JSON escaping + int coercion)
payload=$(REPO_NAME="${REPO_NAME}" BORG_REPO="${BORG_REPO}" BORG_VERSION="${BORG_VERSION}" \
          BORG_ENCRYPTION="${enc}" BORG_COMPRESSION="${comp}" \
          AGENT_ID="${agent_id}" BORG_PASSPHRASE="${BORG_PASSPHRASE:-}" python3 -c '
import json, os
p = {
    "name": os.environ["REPO_NAME"],
    "path": os.environ["BORG_REPO"],
    "borg_version": int(os.environ["BORG_VERSION"]),
    "encryption": os.environ["BORG_ENCRYPTION"],
    "compression": os.environ["BORG_COMPRESSION"],
    "execution_target": "agent",
    "executor_type": "agent",
    "agent_machine_id": int(os.environ["AGENT_ID"]),
}
pw = os.environ.get("BORG_PASSPHRASE")
if pw:
    p["passphrase"] = pw
print(json.dumps(p))') \
  || borgui_die "could not build repo payload (bad BORG_VERSION?)"

# import = record an existing repo; no borg init, no agent round-trip
borgui_api "$jwt" POST /api/repositories/import \
  -H "Content-Type: application/json" -d "${payload}" >/dev/null \
  || borgui_die "repository registration failed"

echo "Repository '${REPO_NAME}' registered (agent id ${agent_id})."
