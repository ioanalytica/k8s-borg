#!/usr/bin/env bash

# Dump every configured instance. rc 1 of an instance is a warning (see
# backup-mariadb): it is passed on once all instances are dumped. Anything
# above fails (rc>=2) at once — without set -e the loop would hide a mid-run
# failure behind the last config's exit code.
#
# backup-cluster-mysql is this script under another name (a link): the
# instances in /root/.mysql, dumped by backup-mysql.
set -e
# shellcheck disable=SC2154  # ec is assigned inside the trap body
trap 'ec=$?; [ "$ec" -lt 2 ] && ec=2; exit "$ec"' ERR

engine=${0##*/backup-cluster-}

rc=0
shopt -s nullglob
for defaults_file in "/root/.${engine}"/*.conf; do
  echo "Running backup-${engine} using ${defaults_file} …"
  instance_rc=0
  "backup-${engine}" "${defaults_file}" || instance_rc=$?
  [ "$instance_rc" -le 1 ] || exit "$instance_rc"
  [ "$instance_rc" -eq 0 ] || rc=1
done

exit "$rc"

# end
