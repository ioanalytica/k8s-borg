#!/usr/bin/env bash
# Break a stale lock on BORG_REPO. Same subcommand name in borg1 and borg2; the
# repo comes from BORG_REPO in the environment, which both majors read, so no
# version branch and no positional repo are needed here. `borg` dispatches to
# the right binary via BORG_VERSION.

borg break-lock "$@"

# end
