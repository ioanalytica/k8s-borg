#!/usr/bin/env python3
"""redis-rdb-sync — stream the RDB snapshot of a Redis or Valkey server to a file.

    redis-rdb-sync [--user U] [--tls] [--cacert F] [--insecure] HOST PORT FILE

The password comes from REDISCLI_AUTH, as for valkey-cli, so that it never
shows in the process list.

This is what `valkey-cli --rdb` does — REPLCONF capa eof, REPLCONF rdb-only 1,
SYNC — plus one step it lacks: a Valkey server is told its own version with
REPLCONF version. Valkey 9 writes its new RDB format (VALKEY080) only to a
replica that announces a version which can read it; to anything else it sends
the old format, which cannot hold its new types (hash fields with a TTL), and
the transfer fails. Redis writes its own format to every replica and is told
nothing.

The server's certificate chain is verified (against --cacert, or the system's
CAs), its host name is not — as valkey-cli does, and as a cluster needs, whose
nodes announce themselves by IP address.

Exit codes: 0 the file holds a complete RDB file, 2 anything else (in the
borg-ui agent script contract rc 1 is only a warning, which a failed dump is
not).
"""

import argparse
import ipaddress
import os
import socket
import ssl
import sys

EOF_MARK_LEN = 40
CHUNK = 1 << 20


class SyncError(Exception):
    pass


def connect(host, port, use_tls, cacert, insecure, timeout):
    sock = socket.create_connection((host, port), timeout=timeout)
    if not use_tls:
        return sock
    ctx = ssl.create_default_context(cafile=cacert or None)
    ctx.check_hostname = False
    if insecure:
        ctx.verify_mode = ssl.CERT_NONE
    try:
        ipaddress.ip_address(host)
        sni = None
    except ValueError:
        sni = host
    return ctx.wrap_socket(sock, server_hostname=sni)


class Conn:
    def __init__(self, sock):
        self.sock = sock
        self.buf = b""

    def _fill(self):
        data = self.sock.recv(CHUNK)
        if not data:
            raise SyncError("the server closed the connection")
        self.buf += data

    def readline(self):
        while b"\n" not in self.buf:
            self._fill()
        line, _, self.buf = self.buf.partition(b"\n")
        return line.rstrip(b"\r")

    def read_some(self):
        if not self.buf:
            self._fill()
        data, self.buf = self.buf, b""
        return data

    def send(self, *args):
        parts = [b"*%d\r\n" % len(args)]
        for arg in args:
            arg = arg.encode() if isinstance(arg, str) else arg
            parts.append(b"$%d\r\n%s\r\n" % (len(arg), arg))
        self.sock.sendall(b"".join(parts))

    def reply(self):
        """One reply: a status/error line, or a bulk string (INFO)."""
        line = self.readline()
        if line.startswith(b"$"):
            n = int(line[1:])
            if n < 0:
                return b""
            while len(self.buf) < n + 2:
                self._fill()
            data, self.buf = self.buf[:n], self.buf[n + 2:]
            return data
        if line.startswith(b"-"):
            raise SyncError(line[1:].decode(errors="replace"))
        return line[1:]

    def call(self, *args):
        self.send(*args)
        return self.reply()


def valkey_version(info):
    for line in info.decode(errors="replace").splitlines():
        if line.startswith("valkey_version:"):
            return line.split(":", 1)[1].strip()
    return None


def receive_rdb(conn, out):
    """Read the SYNC answer into OUT; returns the number of bytes written."""
    conn.sock.sendall(b"SYNC\r\n")
    # While the server prepares the snapshot it sends a bare newline now and
    # then to keep the connection alive.
    line = b""
    while not line:
        line = conn.readline()
    if line.startswith(b"-"):
        raise SyncError("SYNC failed: " + line[1:].decode(errors="replace"))
    if not line.startswith(b"$"):
        raise SyncError("unexpected answer to SYNC: %r" % line[:80])

    written = 0
    if line.startswith(b"$EOF:"):
        # Diskless: the payload ends with the 40 bytes announced here.
        mark = line[5:]
        if len(mark) != EOF_MARK_LEN:
            raise SyncError("malformed EOF marker: %r" % line[:80])
        held = b""
        while True:
            data = held + conn.read_some()
            if data.endswith(mark):
                out.write(data[:-EOF_MARK_LEN])
                return written + len(data) - EOF_MARK_LEN
            keep = min(len(data), EOF_MARK_LEN)
            out.write(data[:-keep] if keep else data)
            written += len(data) - keep
            held = data[len(data) - keep:]

    size = int(line[1:])
    while written < size:
        data = conn.read_some()
        rest = size - written
        if len(data) > rest:
            data = data[:rest]
        out.write(data)
        written += len(data)
    return written


def check_rdb(path):
    with open(path, "rb") as f:
        head = f.read(9)
        f.seek(0, os.SEEK_END)
        size = f.tell()
        if size >= 9:
            f.seek(-9, os.SEEK_END)
            tail = f.read(1)
        else:
            tail = b""
    if not (head.startswith(b"REDIS") or head.startswith(b"VALKEY")):
        raise SyncError("the server sent no RDB file (it starts with %r)" % head)
    # The last record is the EOF opcode, followed by the 8-byte checksum.
    if tail != b"\xff":
        raise SyncError("the RDB file is truncated (%d bytes, no EOF record)" % size)


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--user")
    p.add_argument("--tls", action="store_true")
    p.add_argument("--cacert")
    p.add_argument("--insecure", action="store_true")
    p.add_argument("--timeout", type=float, default=300.0,
                   help="seconds without any data before giving up (default 300)")
    p.add_argument("host")
    p.add_argument("port", type=int)
    p.add_argument("file")
    a = p.parse_args()
    where = "%s:%d" % (a.host, a.port)
    try:
        conn = Conn(connect(a.host, a.port, a.tls or a.cacert or a.insecure,
                            a.cacert, a.insecure, a.timeout))
        password = os.environ.get("REDISCLI_AUTH")
        if password:
            conn.call("AUTH", *([a.user] if a.user else []), password)
        version = valkey_version(conn.call("INFO", "server"))
        # Older servers may not know an option; SYNC then still works, or
        # fails with the reason (valkey-cli goes on in the same way).
        for args in (("capa", "eof"), ("rdb-only", "1")) + ((("version", version),) if version else ()):
            try:
                conn.call("REPLCONF", *args)
            except SyncError as e:
                print("%s: REPLCONF %s: %s" % (where, args[0], e), file=sys.stderr)
        with open(a.file, "wb") as out:
            size = receive_rdb(conn, out)
            out.flush()
            os.fsync(out.fileno())
        check_rdb(a.file)
    except (SyncError, OSError, ValueError) as e:
        print("Error: %s: %s" % (where, e), file=sys.stderr)
        return 2
    print("%s: %d bytes%s" % (where, size, " (Valkey %s)" % version if version else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
