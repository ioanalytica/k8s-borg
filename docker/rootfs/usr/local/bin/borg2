#!/usr/bin/env bash
# Borg 2 wrapper / gateway.
#
# Provides the `borg2` command on PATH; the real Borg 2 binary lives in its own
# venv (/opt/borg-ui-agent/borg2-venv/bin/borg). Does two things:
#
# 1) Injects default common params (BORG2_DEFAULT_PARAMS); Borg 2 reaches a
#    Storage Box over sftp:// and usually needs none. Server-provided flags in
#    "$@" override the defaults (last occurrence wins).
#
# 2) Warning handling, identical to the borg1 wrapper. Borg uses legacy exit
#    codes (0 = ok, 1 = warning, >=2 = error) unless BORG_EXIT_CODES=modern,
#    which we don't set. By DEFAULT a warning (rc=1) is downgraded to 0 so a
#    managed-agent backup job isn't marked "failed" on a routine warning; set
#    BORG_TREAT_WARNINGS_AS_ERRORS=true to pass it through unchanged.
#
# NB: run (not exec) so we can remap the exit code; borg2 shares this process
# group, so the agent's process-group SIGTERM still cancels it cleanly.
#
# STREAM INVARIANT — do NOT merge stdout/stderr here (no `2>&1`). BorgUI is a
# managed-agent caller that relies on the two streams staying separate (it
# parses borg's stdout, e.g. `--json`, and reads stderr for warnings/errors).
# borg's own streams pass through untouched below; any wrapper diagnostics go
# to stderr (>&2) so they never contaminate stdout. Only *other* scripts here
# (never called by BorgUI) may fold stderr into stdout for kubectl/Loki logs.

# --remote-path: path to the borg executable on an ssh:// server. Injected when
# BORG_REMOTE_PATH is set (from the chart's borg.remotePath). An explicit
# --remote-path later in the command still wins (argparse: last occurrence).
remote_args=()
[ -n "${BORG_REMOTE_PATH:-}" ] && remote_args=(--remote-path="${BORG_REMOTE_PATH}")

/opt/borg-ui-agent/borg2-venv/bin/borg "${remote_args[@]}" ${BORG2_DEFAULT_PARAMS:-} "$@"
rc=$?

if [ "$rc" -eq 1 ] && [ "${BORG_TREAT_WARNINGS_AS_ERRORS:-false}" != "true" ]; then
  echo "borg2: warning (rc=1) treated as success (set BORG_TREAT_WARNINGS_AS_ERRORS=true to propagate)" >&2
  rc=0
fi
exit "$rc"
