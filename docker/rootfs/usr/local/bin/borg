#!/usr/bin/env bash
# Borg gateway — dispatches to Borg 1 or Borg 2 based on BORG_VERSION.
#
# The idea: inside a pod you can always call `borg` and get the version this
# repo actually uses, decided by the BORG_VERSION env (1 = default, 2 = Borg 2).
# The sibling `borg2` wrapper ALWAYS runs Borg 2, regardless of BORG_VERSION.
#
#   BORG_VERSION=2 → hand off to `borg2`, which owns the Borg 2 binary path,
#                    BORG2_DEFAULT_PARAMS and the shared warning handling.
#   otherwise      → run the real Borg 1 at $BORG1_BINARY (this script), below.
#
# NB: one BORG_VERSION per pod — an agent/pod is bound to repos of a single borg
# version, so a single env value is enough.
#
# --- Borg 1 path (BORG_VERSION != 2) -----------------------------------------
#
# Sits in front of the real Borg 1 binary on PATH (/usr/local/bin before
# /usr/bin) and does two things:
#
# 1) Injects default common params (BORG1_DEFAULT_PARAMS), e.g.
#    `--remote-path=borg-1.4` for a Hetzner Storage Box reached over ssh://.
#    Server-provided flags in "$@" override the defaults: borg's argparse lets
#    the last occurrence of an option win, and "$@" comes after the defaults.
#
# 2) Warning handling. A borg warning (a listed path is missing, or a file
#    changed/vanished mid-backup — on a live filesystem essentially routine)
#    otherwise propagates as non-zero and makes a managed-agent backup job count
#    as "failed". By DEFAULT this wrapper downgrades a warning to 0 for the
#    caller — same spirit as borg-backup. A warning is identified mode-agnostic
#    via borg_rc_is_warning (see /usr/local/lib/borg-rc.sh): legacy warning = 1,
#    modern warning = 100..127; errors always pass through. Set
#    BORG_TREAT_WARNINGS_AS_ERRORS=true to propagate warnings unchanged instead.
#
# NB: we run borg (not exec) so we can remap its exit code; borg shares this
# process group, so the agent's process-group SIGTERM still cancels it cleanly.
#
# STREAM INVARIANT — do NOT merge stdout/stderr here (no `2>&1`). BorgUI is a
# managed-agent caller that relies on the two streams staying separate (it
# parses borg's stdout, e.g. `--json`, and reads stderr for warnings/errors).
# borg's own streams pass through untouched below; any wrapper diagnostics go
# to stderr (>&2) so they never contaminate stdout. Only *other* scripts here
# (never called by BorgUI) may fold stderr into stdout for kubectl/Loki logs.

# Delegate to the Borg 2 wrapper when this repo is Borg 2. exec (not run): borg2
# does its own exit-code remap and SIGTERM handling, so nothing is left to do.
if [ "${BORG_VERSION:-1}" = "2" ]; then
  exec "${BORG_BIN_DIR:-/usr/local/bin}/borg2" "$@"
fi

# --remote-path: path to the borg executable on an ssh:// server. Injected when
# BORG_REMOTE_PATH is set (from the chart's borg.remotePath). An explicit
# --remote-path later in the command still wins (argparse: last occurrence).
remote_args=()
[ -n "${BORG_REMOTE_PATH:-}" ] && remote_args=(--remote-path="${BORG_REMOTE_PATH}")

"${BORG1_BINARY:-/opt/borg-ui-agent/borg1/current/borg}" "${remote_args[@]}" ${BORG1_DEFAULT_PARAMS:-} "$@"
rc=$?

# shellcheck source=../lib/borg-rc.sh
. "${BORG_LIB_DIR:-/usr/local/lib}/borg-rc.sh"
if borg_rc_is_warning "$rc" && [ "${BORG_TREAT_WARNINGS_AS_ERRORS:-false}" != "true" ]; then
  echo "borg: warning (rc=$rc) treated as success (set BORG_TREAT_WARNINGS_AS_ERRORS=true to propagate)" >&2
  rc=0
fi
exit "$rc"
