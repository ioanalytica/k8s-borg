#!/usr/bin/env bash


# some helpers and error handling:
info() { printf "\n%s %s\n\n" "$( date )" "$*" >&2; }
trap 'echo $( date ) Backup interrupted >&2; exit 2' INT TERM

info "Starting backup ..."

BORG_PATTERNS="/root/.borg/cluster-include.patterns"
BORG_EXCLUDES="/root/.borg/cluster-exclude.patterns"
BORG_NODE_PATTERNS="/root/.borg/node-include.patterns"
BORG_NODE_EXCLUDES="/root/.borg/node-exclude.patterns"

# retention policy (overridable via ENV, safe defaults)
KEEP_DAILY=${KEEP_DAILY:-7}
KEEP_WEEKLY=${KEEP_WEEKLY:-4}
KEEP_MONTHLY=${KEEP_MONTHLY:-6}


if [[ "${BORG_MODE}" = "node" ]]; then
    info "Running in DaemonSet mode."
    BACKUP_PATTERNS=${BORG_NODE_PATTERNS}
    BACKUP_EXCLUDES=${BORG_NODE_EXCLUDES}
else
    BACKUP_PATTERNS=${BORG_PATTERNS}
    BACKUP_EXCLUDES=${BORG_EXCLUDES}
fi

# Idempotent; guarantees the repo exists (or exits non-zero on real failure).
borg-init || exit $?

# Archive name: an explicit BORG_ARCHIVE_NAME_TEMPLATE (e.g. from the chart's
# borg.archiveNameTemplate — same knob register-backup-plan honours) wins;
# otherwise fall back to the prefix-based default. borg expands {now:FMT}.
# NB: plain if-assignment, not ${VAR:-default} — the literal "}" in "{now:…}"
# would prematurely close the brace expansion.
if [ -n "${BORG_ARCHIVE_NAME_TEMPLATE:-}" ]; then
    ARCHIVE_NAME="${BORG_ARCHIVE_NAME_TEMPLATE}"
else
    ARCHIVE_NAME="${NODE_NAME}-{now:%Y-%m-%d-%s}"
fi

# borg2 dropped the REPO::ARCHIVE syntax: the archive is a bare name and the
# repo comes from the BORG_REPO env. borg1 still wants REPO::ARCHIVE.
if [ "${BORG_VERSION:-1}" = "2" ]; then
    ARCHIVE_TARGET="${ARCHIVE_NAME}"
else
    ARCHIVE_TARGET="${BORG_REPO}::${ARCHIVE_NAME}"
fi

borg create \
    --verbose \
    --filter AME \
    --list \
    --stats \
    --show-rc \
    --files-cache=mtime,size \
    --compression auto,lz4 \
    --exclude-caches \
    --exclude-from=${BACKUP_EXCLUDES}  \
    --patterns-from=${BACKUP_PATTERNS}  \
    "$@" \
    "${ARCHIVE_TARGET}"

backup_exit=$?

info "Pruning repository ..."

# prune/compact: same command name in borg1/borg2; repo from BORG_REPO env in
# both (borg2 rejects a positional repo), so no version branch — just omit it.
borg prune                     \
    --verbose                  \
    --list                     \
    --show-rc                  \
    --keep-within   24H              \
    --keep-daily    ${KEEP_DAILY}    \
    --keep-weekly   ${KEEP_WEEKLY}   \
    --keep-monthly  ${KEEP_MONTHLY}  \

prune_exit=$?

info "Compacting repository ..."

borg compact                   \
    --verbose                  \
    --show-rc                  \

compact_exit=$?

info_exit=$?

# use highest exit code as global exit code
global_exit=$(( backup_exit > prune_exit ? backup_exit : prune_exit ))
global_exit=$(( global_exit > compact_exit ? global_exit : compact_exit ))
global_exit=$(( global_exit > info_exit ? global_exit : info_exit ))

if [ ${global_exit} -eq 1 ]; then
    info "Backup, Prune and/or Compact finished with a warning!"
    global_exit=0
fi

if [ ${global_exit} -gt 1 ]; then
    info "Backup, Prune and/or Compact finished with an error!"
fi

borg-info
borg-list

exit ${global_exit}

# end
