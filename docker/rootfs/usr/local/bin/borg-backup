#!/usr/bin/env bash


# some helpers and error handling:
info() { printf "\n%s %s\n\n" "$( date )" "$*" >&2; }
trap 'echo $( date ) Backup interrupted >&2; exit 2' INT TERM

# Borg exit-code semantics (warning detection + combining), mode-agnostic.
# shellcheck source=../lib/borg-rc.sh
. "${BORG_LIB_DIR:-/usr/local/lib}/borg-rc.sh"

info "Starting backup ..."

BORG_PATTERNS="/root/.borg/cluster-include.patterns"
BORG_EXCLUDES="/root/.borg/cluster-exclude.patterns"
BORG_NODE_PATTERNS="/root/.borg/node-include.patterns"
BORG_NODE_EXCLUDES="/root/.borg/node-exclude.patterns"

# retention policy (overridable via ENV, safe defaults)
KEEP_DAILY=${KEEP_DAILY:-7}
KEEP_WEEKLY=${KEEP_WEEKLY:-4}
KEEP_MONTHLY=${KEEP_MONTHLY:-6}


if [[ "${BORG_MODE}" = "node" ]]; then
    info "Running in DaemonSet mode."
    BACKUP_PATTERNS=${BORG_NODE_PATTERNS}
    BACKUP_EXCLUDES=${BORG_NODE_EXCLUDES}
else
    BACKUP_PATTERNS=${BORG_PATTERNS}
    BACKUP_EXCLUDES=${BORG_EXCLUDES}
fi

# The pattern files always exist (chart ConfigMap), but may hold only comments /
# a "P …" style line and no actual source roots. borg would then abort with a
# cryptic error, so skip cleanly with a message that points the operator at the
# right knob instead of at the mounted file.
if ! grep -qE '^[[:space:]]*[Rr][[:space:]]' "${BACKUP_PATTERNS}" 2>/dev/null; then
    info "No source roots (\"R <path>\") in ${BACKUP_PATTERNS} — nothing to back up. Add roots via ${BORG_MODE}.include in the chart values. Skipping."
    exit 0
fi

# Idempotent; guarantees the repo exists (or exits non-zero on real failure).
borg-init || exit $?

# Archive name: an explicit BORG_ARCHIVE_NAME_TEMPLATE (e.g. from the chart's
# borg.archiveNameTemplate — same knob register-backup-plan honours) wins;
# otherwise fall back to the prefix-based default. borg expands {now:FMT}.
# NB: plain if-assignment, not ${VAR:-default} — the literal "}" in "{now:…}"
# would prematurely close the brace expansion.
if [ -n "${BORG_ARCHIVE_NAME_TEMPLATE:-}" ]; then
    ARCHIVE_NAME="${BORG_ARCHIVE_NAME_TEMPLATE}"
else
    ARCHIVE_NAME="${NODE_NAME}-{now:%Y-%m-%d-%s}"
fi

# borg2 dropped the REPO::ARCHIVE syntax: the archive is a bare name and the
# repo comes from the BORG_REPO env. borg1 still wants REPO::ARCHIVE.
if [ "${BORG_VERSION:-1}" = "2" ]; then
    ARCHIVE_TARGET="${ARCHIVE_NAME}"
else
    ARCHIVE_TARGET="${BORG_REPO}::${ARCHIVE_NAME}"
fi

# Only match on mtime+size when an S3 bucket is actually mounted (s3fs inodes are
# unstable → borg's default would re-download the whole bucket every run). On a
# local FS this stays empty and borg keeps its strict default. See
# borg-files-cache-flag.
files_cache_args=()
fc_mode="$(borg-files-cache-flag)"
[ -n "$fc_mode" ] && files_cache_args=(--files-cache="$fc_mode")

borg create \
    --verbose \
    --filter AME \
    --list \
    --stats \
    --show-rc \
    "${files_cache_args[@]}" \
    --compression auto,lz4 \
    --exclude-caches \
    --exclude-from=${BACKUP_EXCLUDES}  \
    --patterns-from=${BACKUP_PATTERNS}  \
    "$@" \
    "${ARCHIVE_TARGET}"

backup_exit=$?

info "Pruning repository ..."

# prune/compact: same command name in borg1/borg2; repo from BORG_REPO env in
# both (borg2 rejects a positional repo), so it is just omitted.
# borg 2.0.0b22 removed --keep-within (and --keep-last) in favour of --keep,
# which takes the same interval; borg 1 has no --keep. This is the one prune
# flag the two majors spell differently.
if [ "${BORG_VERSION:-1}" = "2" ]; then
  keep_recent=(--keep 24H)
else
  keep_recent=(--keep-within 24H)
fi

borg prune                     \
    --verbose                  \
    --list                     \
    --show-rc                  \
    "${keep_recent[@]}"        \
    --keep-daily    ${KEEP_DAILY}    \
    --keep-weekly   ${KEEP_WEEKLY}   \
    --keep-monthly  ${KEEP_MONTHLY}  \

prune_exit=$?

info "Compacting repository ..."

borg compact                   \
    --verbose                  \
    --show-rc                  \

compact_exit=$?

# Combine the borg exit codes with borg precedence (error > warning > ok), NOT
# numeric max: under modern codes a warning (100..127) is numerically larger
# than an error (2..99), so a max() would hide the error. See borg-rc.sh.
global_exit="$(borg_rc_worst "$backup_exit" "$prune_exit" "$compact_exit")"

if borg_rc_is_warning "${global_exit}"; then
    info "Backup, Prune and/or Compact finished with a warning!"
    global_exit=0
elif [ "${global_exit}" -ne 0 ]; then
    info "Backup, Prune and/or Compact finished with an error!"
fi

borg-info
borg-list

exit ${global_exit}

# end
