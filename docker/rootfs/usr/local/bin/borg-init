#!/usr/bin/env bash

set -euo pipefail


# Idempotent: an already-existing repository is NOT an error here — only real
# failures (auth, network, …) should abort the caller.
if out=$(borg init --encryption=repokey-blake2 2>&1); then
  printf '%s\n' "$out"
elif printf '%s' "$out" | grep -qi 'already exist'; then
  echo "BORG_REPO already exists — skipping init."
else
  printf '%s\n' "$out" >&2
  exit 2
fi

# end
