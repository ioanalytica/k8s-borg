#!/usr/bin/env bash
#
# Ensure BORG_REPO exists. Idempotent and self-contained: after this script
# returns 0, the repository is guaranteed to exist — whether it was just
# created or already present. Callers may therefore rely on a plain
# `borg-init` without any exit-code decoding of their own.
#
# Exit status:
#   0  repository exists (created now, or already there)
#   1  real failure (auth, network, unreachable storage, …) → caller must abort
#
# NB: no `set -e` — we inspect borg's status ourselves and normalise it.
set -uo pipefail

# borg2 renamed `init` to `repo-create`; `borg` dispatches to the right binary,
# and both majors take the repo from BORG_REPO. What BORG_ENCRYPTION becomes on
# the command line, and its default per major, is borg-encryption.sh's table —
# shared with register-repo, which records the mode in Borg UI.
# shellcheck source=../lib/borg-encryption.sh
. "${BORG_LIB_DIR:-/usr/local/lib}/borg-encryption.sh"
borg_encryption "${BORG_VERSION:-1}" || exit 1
# shellcheck disable=SC2154  # borg_enc_args is set by borg_encryption
if [ "${BORG_VERSION:-1}" = "2" ]; then
  init_cmd=(repo-create "${borg_enc_args[@]}")
else
  init_cmd=(init "${borg_enc_args[@]}")
fi

# The shared pack cache stays out of repo creation: borgstore rejects an
# already-populated cache directory on create, and borg misreports that as
# "repository already exists" — which the exists-branch below would then
# trust, leaving the repository uncreated. Borg 1 ignores the variable.
if out=$(BORG_STORE_CACHE="" borg "${init_cmd[@]}" 2>&1); then
  echo "Repository didn't exist and has been created."
  exit 0
# Anchored to borg's actual message ("A repository already exists at …") so
# an unrelated "already exists" elsewhere in the output cannot fake it.
elif printf '%s' "$out" | grep -qi 'repository already exists'; then
  echo "Repository already exists — skipping init."
  exit 0
elif [[ "${out%%$'\n'*}" == "usage: "* ]]; then
  # borg rejected the command line, so it never reached the repository. Saying
  # "cannot be accessed" here sends the reader after storage, credentials and
  # the network for a fault that is entirely on this side — as a borg version
  # bump that changes an option's spelling reliably does.
  #
  # argparse prints its usage text before anything else, and both majors exit
  # with 2 for it as for a repository they cannot reach — so the first line
  # decides, case-sensitively. Borg 2's run-time "Error: Could not access the
  # repository …" quotes the remote side's stderr after it, which can hold a
  # remote Borg's own usage error; that is not this command line.
  printf '%s\n' "$out" >&2
  echo "borg rejected the repo-creation command — this is a bug in borg-init," >&2
  echo "not a problem with the repository (borg ${BORG_VERSION:-1})." >&2
  exit 1
else
  printf '%s\n' "$out" >&2
  echo "Repository cannot be accessed!" >&2
  exit 1
fi

# end
