#!/usr/bin/env bash
#
# Set the Borg UI check-schedule for this node's repository from config.
# Declarative: applies the configured cron (creates/updates/re-enables as needed).
#
# Standalone command — also called by run-agent.sh. Auth (borgui-common.sh) is
# PAT-first: BORG_UI_ADMIN_PAT when it works, else BORG_UI_ADMIN_USER/PASS; a
# parent may share a resolved token via BORG_UI_JWT to skip re-auth.
#
# Cron resolution — first match wins:
#   1. $BORG_CHECK_CRON                                          (test override)
#   2. $BORG_CHECK_SCHEDULE_DIR/<repo_name>_check_schedule       (per-repo key)
#   3. $BORG_CHECK_SCHEDULE_DIR/default_check_schedule           (fallback key)
#   4. none  ->  only a schedule this script set itself is removed (see below)
# The value "off" removes the repository's check schedule, whoever set it, and
# keeps a pod with that per-repo key off the fallback.
#
# Ownership: a check schedule set by hand in Borg UI must survive the starts of
# a release that configures none. So the script records the schedule it set as
# "<repo id> <cron>" in $BORG_CHECK_SCHEDULE_OWNED, on the agent's persistent
# volume, also when the configured cron was already set (by an older version).
# With no cron configured it removes the schedule only while Borg UI still has
# exactly that cron for that repository; one given another cron in Borg UI
# since is left alone and no longer counts as its own. run-agent.sh drops the
# record when the agent enrols anew: it holds for one server only.
#
# The config is a ConfigMap projected as a directory of files, one file per key
# (chosen over envFrom because repo names are pod hostnames and may contain '-'
# or '.', which are invalid in env var names but fine as file names):
#   data:
#     <repo_name>_check_schedule: "0 3 * * *"   # e.g. small node repos, daily
#     default_check_schedule:     "0 3 * * 0"   # fallback, weekly
#   mounted at $BORG_CHECK_SCHEDULE_DIR (default /etc/borg-ui-agent/check-schedules)
#
#   BORG_UI_SERVER      e.g. http://k8s-borg-ui.borg.svc.cluster.local:8081
#   BORG_REPO           repository path/URL (used to locate the repo record)
#   BORG_UI_AGENT_NAME  optional; repo/agent name. Default: pod hostname.
#   BORG_CHECK_TIMEZONE optional; default $TZ, else the server default.
#   BORG_CHECK_SCHEDULE_OWNED  optional; default /etc/borg-ui-agent/check-schedule-owned
#   BORG_UI_ADMIN_PAT   preferred admin credential (bootstrap-minted PAT)
#   BORG_UI_ADMIN_USER  admin user   (fallback when no working PAT)
#   BORG_UI_ADMIN_PASS  admin password (fallback when no working PAT)
#   BORG_UI_JWT         optional; a pre-resolved token shared by a parent
#
set -euo pipefail

# shellcheck source=../lib/borgui-common.sh
. "${BORG_LIB_DIR:-/usr/local/lib}/borgui-common.sh"

borgui_require_server
: "${BORG_REPO:?set BORG_REPO to locate the repository record}"

: "${REPO_NAME:=${BORG_UI_AGENT_NAME:-$(hostname)}}"
: "${BORG_CHECK_SCHEDULE_DIR:=/etc/borg-ui-agent/check-schedules}"
: "${BORG_CHECK_SCHEDULE_OWNED:=/etc/borg-ui-agent/check-schedule-owned}"

# --- 1) resolve the cron expression from override / ConfigMap ----------------
cron=$(borgui_resolve_cron "${BORG_CHECK_CRON:-}" "${BORG_CHECK_SCHEDULE_DIR}" "_check_schedule")

# The schedule this script set last: "<repo id> <cron>".
owned_id="" owned_cron=""
if [ -f "$BORG_CHECK_SCHEDULE_OWNED" ]; then
  read -r owned_id owned_cron <"$BORG_CHECK_SCHEDULE_OWNED" || true
fi

if [ -z "$cron" ] && [ -z "$owned_id" ]; then
  echo "No check schedule configured for '${REPO_NAME}' (no ${REPO_NAME}_check_schedule / default_check_schedule) — skipping."
  exit 0
fi
if [ -z "$cron" ]; then
  echo "No check schedule configured for '${REPO_NAME}' any more — removing '${owned_cron}', set from the values, unless Borg UI has another cron."
else
  echo "Check schedule for '${REPO_NAME}': '${cron}'"
fi

# --- 2) admin bearer token (PAT-first; reuses BORG_UI_JWT if a parent set it) -
jwt=$(borgui_bearer) || borgui_die "could not authenticate to Borg UI"

# --- 3) resolve repo_id (match by name OR path) ------------------------------
repo_row=$(borgui_repo_row "$jwt") || borgui_die "could not list repositories"
repo_id="${repo_row%%$'\t'*}"

if [ -z "$repo_id" ]; then
  borgui_die "repository '${REPO_NAME}' (${BORG_REPO}) not found — register it first."
fi

# --- 4) the current schedule: "<cron>\t<1 if it runs, else 0>" ---------------
current=$(borgui_api "$jwt" GET "/api/repositories/${repo_id}/check-schedule" \
          | python3 -c 'import sys,json; d=json.load(sys.stdin); print((d.get("check_cron_expression") or "") + "\t" + ("1" if d.get("enabled") else "0"))') \
  || current=""

# record_owned — note the configured cron as this script's own (best effort).
record_owned() {
  printf '%s %s\n' "$repo_id" "$cron" >"$BORG_CHECK_SCHEDULE_OWNED" 2>/dev/null \
    || echo "WARN: could not write ${BORG_CHECK_SCHEDULE_OWNED} — removing '${cron}' from the values will leave it in Borg UI." >&2
}

# --- 5a) none configured, or "off": remove ------------------------------------
if [ -z "$cron" ] || [ "$cron" = "off" ]; then
  # Without the current schedule its owner is unknown: keep the record and
  # try again at the next start.
  [ -n "$current" ] || borgui_die "could not read the current check schedule"
  cur_cron="${current%%$'\t'*}"
  if [ -z "$cur_cron" ]; then
    echo "No check schedule set for '${REPO_NAME}' — nothing to remove."
  elif [ "$cron" != "off" ] && { [ "$owned_id" != "$repo_id" ] || [ "$owned_cron" != "$cur_cron" ]; }; then
    echo "Check schedule '${cur_cron}' of '${REPO_NAME}' was not set from the values, or given another cron in Borg UI since — leaving it."
  else
    # An empty cron is Borg UI's "remove schedule": it also turns it off.
    borgui_api "$jwt" PUT "/api/repositories/${repo_id}/check-schedule" \
      -H "Content-Type: application/json" -d '{"cron_expression": ""}' >/dev/null \
      || borgui_die "failed to remove check schedule"
    echo "Check schedule '${cur_cron}' removed for '${REPO_NAME}' (repo id ${repo_id})."
  fi
  rm -f "$BORG_CHECK_SCHEDULE_OWNED"
  exit 0
fi

# --- 5b) idempotent: skip if already enabled with this exact cron ------------
if [ -z "$current" ]; then
  echo "WARN: could not read current schedule — will try to set it." >&2
  current=$'\t0'
fi
cur_cron="${current%%$'\t'*}"
cur_en="${current##*$'\t'}"
if [ "$cur_en" = "1" ] && [ "$cur_cron" = "$cron" ]; then
  record_owned
  echo "Check schedule already set to '${cron}' and enabled — nothing to do."
  exit 0
fi

# --- 6) PUT the schedule -----------------------------------------------------
payload=$(CRON="$cron" TZ_VAL="${BORG_CHECK_TIMEZONE:-${TZ:-}}" python3 -c '
import json, os
b = {"cron_expression": os.environ["CRON"], "schedule_enabled": True}
tz = os.environ.get("TZ_VAL")
if tz:
    b["timezone"] = tz
print(json.dumps(b))')

borgui_api "$jwt" PUT "/api/repositories/${repo_id}/check-schedule" \
  -H "Content-Type: application/json" -d "${payload}" >/dev/null \
  || borgui_die "failed to set check schedule"
record_owned

echo "Check schedule set for '${REPO_NAME}' (repo id ${repo_id}): '${cron}'."
