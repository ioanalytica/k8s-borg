#!/usr/bin/env bash
# Delete the whole repository (BORG_REPO). borg2 split this out into
# `repo-delete` — in borg2 `borg delete` removes a single archive instead.
# `borg` dispatches to the right binary via BORG_VERSION.

if [ "${BORG_VERSION:-1}" = "2" ]; then
  # Repo deletion must not touch the shared pack cache: with the cache
  # enabled, repo-delete removes the whole cache directory, evicting every
  # other repository's cached packs.
  BORG_STORE_CACHE="" borg repo-delete "$@"
else
  borg delete "$@"
fi

# end
