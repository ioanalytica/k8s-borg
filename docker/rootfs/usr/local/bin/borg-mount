#!/usr/bin/env bash


BORG_BACKUP_SET=$1

usage() {
    echo "Usage: $0 <borg backup set>"
    echo ""
    echo "Existing backup sets can be retrieved with"
    echo "      borg list"
    exit 1
}

if [ -z "$BORG_BACKUP_SET" ];  then
    usage
fi

echo "Mounting ${BORG_REPO}::${BORG_BACKUP_SET} ..."

mkdir -p /mnt/borg
# borg2 dropped the REPO::ARCHIVE syntax — pass a bare archive name; the repo
# comes from the borg2 wrapper's injected `-r $BORG_REPO`. borg1 wants
# REPO::ARCHIVE. `borg` dispatches to the right binary via BORG_VERSION.
if [ "${BORG_VERSION:-1}" = "2" ]; then
  borg mount "${BORG_BACKUP_SET}" /mnt/borg
else
  borg mount ${BORG_REPO}::${BORG_BACKUP_SET} /mnt/borg
fi

if [ $? -gt 0 ];
then
    echo "Mounting ${BORG_REPO}::${BORG_BACKUP_SET} failed!"
else
    echo "Backup set ${BORG_REPO}::${BORG_BACKUP_SET} successfully mounted on /mnt/borg"
fi

# end
