#!/usr/bin/env bash


BORG_BACKUP_SET=$1

usage() {
    echo "Usage: $0 <borg backup set>"
    echo ""
    echo "Existing backup sets can be retrieved with"
    echo "      borg list"
    exit 1
}

if [ -z "$BORG_BACKUP_SET" ];  then
    usage
fi

echo "Mounting ${BORG_REPO}::${BORG_BACKUP_SET} ..."

mkdir -p /mnt/borg
# borg2 dropped the REPO::ARCHIVE syntax and takes the MOUNTPOINT as its only
# positional argument — the archive is selected with -a, and passing it
# positionally would make borg read it as the mountpoint. The repo comes from
# BORG_REPO in the environment. borg1 wants REPO::ARCHIVE. `borg` dispatches to
# the right binary via BORG_VERSION.
# -a takes a match pattern, so a name that repeats across a borg2 series mounts
# every match; pass `aid:<id>` (from `borg-list --format '{id}{NL}'`) for one.
if [ "${BORG_VERSION:-1}" = "2" ]; then
  borg mount -a "${BORG_BACKUP_SET}" /mnt/borg
else
  borg mount ${BORG_REPO}::${BORG_BACKUP_SET} /mnt/borg
fi
mount_rc=$?

# A borg warning still mounts fine, so treat it as success (mode-agnostic; see
# /usr/local/lib/borg-rc.sh). Only a real error is a mount failure.
# shellcheck source=../lib/borg-rc.sh
. /usr/local/lib/borg-rc.sh
if [ "$mount_rc" -ne 0 ] && ! borg_rc_is_warning "$mount_rc"; then
    echo "Mounting ${BORG_REPO}::${BORG_BACKUP_SET} failed!"
else
    echo "Backup set ${BORG_REPO}::${BORG_BACKUP_SET} successfully mounted on /mnt/borg"
fi

# end
