#!/usr/bin/env bash
#
# Reconcile a Borg UI server to the desired state declared in the HelmRelease —
# runs on every install/upgrade (Helm post-* hook), idempotent and cheap on
# re-runs. NOT a one-shot bootstrap: it converges admin PAT, OIDC, the system SSH
# key and remote machines every time, like a controller.
#
#   1. wait for the server to be healthy (GET /health)
#   2. if the current PAT (from the PAT Secret) still authenticates -> reuse it,
#      do nothing else (no admin login, no mint)
#   3. only when the PAT is missing or no longer works:
#        - log in as the built-in admin (configured password, else admin123 +
#          rotate to the configured one), clearing the forced first-login change
#        - revoke stale PATs of the same name, mint a fresh one, write it to the
#          PAT Secret
#   4. optionally (re)configure OIDC/SSO, the system SSH key and remote machines,
#      using the PAT as the admin credential
#
# So the admin username/password is only ever needed on the FIRST run (or if the
# PAT is lost/revoked); steady-state HR updates just verify the PAT.
#
#   BORG_UI_SERVER             e.g. http://k8s-borg-ui.borg.svc.cluster.local:8081
#   BORG_UI_ADMIN_PAT          the current PAT (injected from the PAT Secret; empty first run)
#   BORG_UI_ADMIN_USER         built-in admin (default "admin"; only used to mint)
#   BORG_UI_ADMIN_PASS         admin password (REQUIRED only to mint a new PAT)
#   BORG_UI_ADMIN_DEFAULT_PASS fresh-install fallback (default "admin123")
#   RECONCILE_WAIT_SECONDS     health-wait timeout (default 300)
#   PAT_NAME                   name for the minted PAT (default "k8s-borg-reconcile")
#   PAT_SECRET_NAME            k8s Secret to write the PAT to (needs SA + patch RBAC)
#   PAT_SECRET_KEY             key in that Secret (default "BORG_UI_ADMIN_PAT")
#   OIDC_*                     optional; configured when OIDC_DISCOVERY_URL is set
#   BORG_UI_ENTITLEMENT        optional; signed offline entitlement document (JSON)
#                              to import — the air-gapped path, wins over the key
#   BORG_UI_LICENSE_KEY        optional; license key to activate while the instance
#                              carries no paid license (needs egress)
#   BORG_UI_SSH_IMPORT_PRIVATE_PATH  optional; import this server-side key file as
#                              the system SSH key (+ _PUBLIC_PATH, _NAME)
#   BORG_UI_REMOTE_MACHINES    optional; JSON list [{host,username,port}] to register
#                              as SSH connections against the system key
#   RECONCILE_STATUS_CONFIGMAP optional; ConfigMap to publish the success marker to
#   RECONCILE_TOKEN            optional; marker value (the release revision) agents wait for
#
set -euo pipefail

: "${BORG_UI_SERVER:?set BORG_UI_SERVER, e.g. http://k8s-borg-ui.borg.svc.cluster.local:8081}"
: "${BORG_UI_ADMIN_USER:=admin}"
: "${BORG_UI_ADMIN_DEFAULT_PASS:=admin123}"
: "${RECONCILE_WAIT_SECONDS:=300}"
: "${PAT_NAME:=k8s-borg-reconcile}"
: "${PAT_SECRET_KEY:=BORG_UI_ADMIN_PAT}"

api() { printf '%s/api/%s' "${BORG_UI_SERVER}" "$1"; }

login_as() {  # $1=user $2=pass -> echoes access_token on success
  local t
  t=$(curl -fsS -X POST "$(api auth/login)" \
        --data-urlencode "username=$1" --data-urlencode "password=$2" 2>/dev/null \
      | python3 -c 'import sys,json; print(json.load(sys.stdin).get("access_token") or "")' 2>/dev/null) || return 1
  [ -n "$t" ] || return 1
  printf '%s' "$t"
}

pat_authenticates() {  # $1=pat -> 0 if it authenticates as a user
  [ -n "${1:-}" ] || return 1
  local code
  code=$(curl -sS -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $1" "$(api auth/me)" 2>/dev/null) || return 1
  [ "$code" = "200" ]
}

write_pat_to_secret() {  # $1=pat ; writes to PAT_SECRET_NAME via the k8s API
  local SA=/var/run/secrets/kubernetes.io/serviceaccount ns b64 code
  ns=$(cat "$SA/namespace")
  b64=$(printf %s "$1" | base64 | tr -d '\n')
  code=$(curl -sS -o /dev/null -w '%{http_code}' --cacert "$SA/ca.crt" \
           -H "Authorization: Bearer $(cat "$SA/token")" \
           -H "Content-Type: application/merge-patch+json" \
           -X PATCH "https://kubernetes.default.svc/api/v1/namespaces/${ns}/secrets/${PAT_SECRET_NAME}" \
           -d "{\"data\":{\"${PAT_SECRET_KEY}\":\"${b64}\"}}") \
    || { echo "FATAL: could not reach the k8s API to write the PAT" >&2; return 1; }
  [ "$code" = "200" ] || { echo "FATAL: writing PAT to secret ${PAT_SECRET_NAME} failed (HTTP ${code})" >&2; return 1; }
}

publish_reconcile_marker() {  # writes data.reconciled=$RECONCILE_TOKEN to the status ConfigMap
  local SA=/var/run/secrets/kubernetes.io/serviceaccount ns code
  ns=$(cat "$SA/namespace")
  code=$(curl -sS -o /dev/null -w '%{http_code}' --cacert "$SA/ca.crt" \
           -H "Authorization: Bearer $(cat "$SA/token")" \
           -H "Content-Type: application/merge-patch+json" \
           -X PATCH "https://kubernetes.default.svc/api/v1/namespaces/${ns}/configmaps/${RECONCILE_STATUS_CONFIGMAP}" \
           -d "{\"data\":{\"reconciled\":\"${RECONCILE_TOKEN}\"}}") \
    || { echo "FATAL: could not reach the k8s API to publish the reconcile marker" >&2; return 1; }
  [ "$code" = "200" ] || { echo "FATAL: publishing reconcile marker to ${RECONCILE_STATUS_CONFIGMAP} failed (HTTP ${code})" >&2; return 1; }
}

# --- 1) wait for health ------------------------------------------------------
echo "Waiting for ${BORG_UI_SERVER}/health (up to ${RECONCILE_WAIT_SECONDS}s) …"
deadline=$(( $(date +%s) + RECONCILE_WAIT_SECONDS ))
until curl -fsS -o /dev/null "${BORG_UI_SERVER}/health" 2>/dev/null; do
  [ "$(date +%s)" -lt "$deadline" ] || { echo "FATAL: server not healthy within ${RECONCILE_WAIT_SECONDS}s" >&2; exit 1; }
  sleep 3
done
echo "Server healthy."

# --- 2) reuse the existing PAT if it still works -----------------------------
pat="${BORG_UI_ADMIN_PAT:-}"
if pat_authenticates "$pat"; then
  echo "Existing PAT still valid — reusing (no admin login, no mint)."
else
  # --- 3) (re)mint: the PAT is missing or no longer authenticates ------------
  if [ -n "$pat" ]; then echo "Existing PAT no longer valid — re-minting."; else echo "No PAT yet — minting."; fi
  : "${BORG_UI_ADMIN_PASS:?set BORG_UI_ADMIN_PASS to mint a PAT}"

  # admin login (configured password, else fresh-install default + rotate)
  if jwt=$(login_as "$BORG_UI_ADMIN_USER" "$BORG_UI_ADMIN_PASS"); then
    rotate=0; echo "Admin login OK (configured password)."
  elif jwt=$(login_as "$BORG_UI_ADMIN_USER" "$BORG_UI_ADMIN_DEFAULT_PASS"); then
    rotate=1; echo "Admin login OK (default password) — will rotate to the configured one."
  else
    echo "FATAL: cannot log in as '${BORG_UI_ADMIN_USER}' with the configured or default password." >&2
    exit 1
  fi
  jauth=(-H "Authorization: Bearer ${jwt}")

  # clear forced password change / rotate to the configured value
  if [ "$rotate" = 1 ]; then
    curl -fsS -X POST "$(api auth/change-password)" "${jauth[@]}" -H "Content-Type: application/json" \
      -d "$(BORG_UI_ADMIN_DEFAULT_PASS="$BORG_UI_ADMIN_DEFAULT_PASS" BORG_UI_ADMIN_PASS="$BORG_UI_ADMIN_PASS" python3 -c '
import json, os
print(json.dumps({"current_password": os.environ["BORG_UI_ADMIN_DEFAULT_PASS"],
                  "new_password": os.environ["BORG_UI_ADMIN_PASS"]}))')" >/dev/null \
      || { echo "FATAL: admin password rotation failed" >&2; exit 1; }
    jwt=$(login_as "$BORG_UI_ADMIN_USER" "$BORG_UI_ADMIN_PASS") || { echo "FATAL: re-login after rotation failed" >&2; exit 1; }
    jauth=(-H "Authorization: Bearer ${jwt}")
    echo "Admin password rotated to the configured value."
  else
    curl -fsS -X POST "$(api auth/password-setup/skip)" "${jauth[@]}" >/dev/null 2>&1 || true
  fi

  # revoke stale (dead) PATs of the same name, then mint a fresh one
  for old_id in $(curl -fsS "$(api settings/tokens)" "${jauth[@]}" \
                   | PAT_NAME="$PAT_NAME" python3 -c '
import sys, json, os
name = os.environ["PAT_NAME"]
for t in json.load(sys.stdin):
    if t.get("name") == name:
        print(t["id"])' 2>/dev/null); do
    curl -fsS -X DELETE "$(api settings/tokens)/${old_id}" "${jauth[@]}" >/dev/null 2>&1 || true
    echo "Revoked stale PAT id ${old_id} ('${PAT_NAME}')."
  done

  pat=$(curl -fsS -X POST "$(api settings/tokens)" "${jauth[@]}" -H "Content-Type: application/json" \
          -d "$(PAT_NAME="$PAT_NAME" python3 -c 'import json,os; print(json.dumps({"name": os.environ["PAT_NAME"]}))')" \
        | python3 -c 'import sys,json; print(json.load(sys.stdin).get("token") or "")') \
    || { echo "FATAL: PAT minting failed" >&2; exit 1; }
  [ -n "$pat" ] || { echo "FATAL: server returned no PAT" >&2; exit 1; }
  echo "Minted admin PAT '${PAT_NAME}' (prefix ${pat:0:12})."

  if [ -n "${PAT_SECRET_NAME:-}" ]; then
    write_pat_to_secret "$pat" || exit 1
    echo "PAT written to secret '${PAT_SECRET_NAME}' key '${PAT_SECRET_KEY}'."
  else
    echo "PAT_SECRET_NAME unset (test mode) — the PAT is:"
    echo "  ${pat}"
  fi
fi

# --- 4) optional OIDC/SSO reconciliation (declarative; uses the PAT) ----------
auth=(-H "Authorization: Bearer ${pat}")
if [ -n "${OIDC_DISCOVERY_URL:-}" ]; then
  echo "Reconciling OIDC (provider: ${OIDC_PROVIDER_NAME:-oidc}) …"

  # SAFETY GUARD: never disable local login while no admin can sign in via OIDC
  # yet (would lock everyone out). borg-ui exposes oidc_active_admin_count.
  want_disable="${OIDC_DISABLE_LOCAL_AUTH:-}"
  if [ "$(printf %s "$want_disable" | tr '[:upper:]' '[:lower:]')" = "true" ]; then
    active=$(curl -fsS "$(api settings/system)" "${auth[@]}" \
              | python3 -c 'import sys,json; print(json.load(sys.stdin).get("settings",{}).get("oidc_active_admin_count",0) or 0)' 2>/dev/null || echo 0)
    if [ "${active:-0}" -lt 1 ]; then
      echo "  guard: oidc_active_admin_count=${active} — keeping local login ON (an OIDC admin must sign in first)." >&2
      want_disable="false"
    fi
  fi

  oidc_payload=$(OIDC_WANT_DISABLE="$want_disable" python3 -c '
import json, os
def flag(k, default=None):
    v = os.environ.get(k)
    if v is None or v == "":
        return default
    return v.strip().lower() in ("1","true","yes","on")

p = {"oidc_enabled": flag("OIDC_ENABLED", True),
     "oidc_discovery_url": os.environ["OIDC_DISCOVERY_URL"]}
for env, key in (
    ("OIDC_CLIENT_ID", "oidc_client_id"),
    ("OIDC_CLIENT_SECRET", "oidc_client_secret"),
    ("OIDC_PROVIDER_NAME", "oidc_provider_name"),
    ("OIDC_TOKEN_AUTH_METHOD", "oidc_token_auth_method"),
    ("OIDC_SCOPES", "oidc_scopes"),
    ("OIDC_CLAIM_USERNAME", "oidc_claim_username"),
    ("OIDC_CLAIM_EMAIL", "oidc_claim_email"),
    ("OIDC_CLAIM_FULL_NAME", "oidc_claim_full_name"),
    ("OIDC_GROUP_CLAIM", "oidc_group_claim"),
    ("OIDC_ROLE_CLAIM", "oidc_role_claim"),
    ("OIDC_ADMIN_GROUPS", "oidc_admin_groups"),
    ("OIDC_ALL_REPOS_ROLE_CLAIM", "oidc_all_repositories_role_claim"),
    ("OIDC_NEW_USER_MODE", "oidc_new_user_mode"),
    ("OIDC_NEW_USER_TEMPLATE_USERNAME", "oidc_new_user_template_username"),
    ("OIDC_DEFAULT_ROLE", "oidc_default_role"),
    ("OIDC_DEFAULT_ALL_REPOS_ROLE", "oidc_default_all_repositories_role"),
    ("OIDC_REDIRECT_URI_OVERRIDE", "oidc_redirect_uri_override"),
    ("OIDC_END_SESSION_OVERRIDE", "oidc_end_session_endpoint_override"),
):
    v = os.environ.get(env)
    if v:
        p[key] = v
wd = flag("OIDC_WANT_DISABLE")
if wd is not None:
    p["oidc_disable_local_auth"] = wd
print(json.dumps(p))')

  curl -fsS -X PUT "$(api settings/system)" "${auth[@]}" -H "Content-Type: application/json" \
    -d "${oidc_payload}" >/dev/null \
    || { echo "FATAL: OIDC configuration failed" >&2; exit 1; }
  ll="ON"; [ "$(printf %s "$want_disable" | tr '[:upper:]' '[:lower:]')" = "true" ] && ll="OFF"
  echo "OIDC reconciled — enabled; local login ${ll}."
fi

# --- 4b) optional cache (Redis + TTL) reconciliation -------------------------
# borg-ui's cache config lives in the DB (SystemSettings): it's what the UI shows
# AND it reconfigures the live cache. Env vars only seed the server's startup
# defaults, so push the desired Redis URL + TTL here so the HR is the source of
# truth and a stray UI Save can't silently drop the cache back to in-memory. The
# redis_url is assembled from the same REDIS_* the server gets (REDIS_URL wins;
# else built from host/port/db + optional password).
cache_qs=$(python3 -c '
import os, urllib.parse
url = os.environ.get("REDIS_URL", "")
if not url and os.environ.get("REDIS_HOST"):
    pw = os.environ.get("REDIS_PASSWORD", "")
    auth_part = ":%s@" % urllib.parse.quote(pw, safe="") if pw else ""
    url = "redis://%s%s:%s/%s" % (
        auth_part, os.environ["REDIS_HOST"],
        os.environ.get("REDIS_PORT", "6379"), os.environ.get("REDIS_DB", "0"))
params = {}
if url:
    params["redis_url"] = url
ttl = os.environ.get("CACHE_TTL_MINUTES", "")
if ttl:
    params["cache_ttl_minutes"] = ttl
print(urllib.parse.urlencode(params))')
if [ -n "$cache_qs" ]; then
  echo "Reconciling cache settings …"
  curl -fsS -X PUT "$(api settings/cache/settings)?${cache_qs}" "${auth[@]}" >/dev/null \
    || { echo "FATAL: cache settings reconciliation failed" >&2; exit 1; }
  echo "Cache settings reconciled."
fi

# --- 4c) optional license reconciliation -------------------------------------
# The plan is evaluated from a signed entitlement stored in the server's DB, so a
# license is applied through the API — either by importing an already-signed
# document (air-gapped, no egress) or by activating a key against the activation
# service. A document is bound to the instance_id the server generated on its
# first boot, which lives only in the database: rebuild the instance and the
# document no longer fits. So the document is used only while it matches, and a
# license key, being instance-independent, is what recovers a rebuilt instance.
if [ -n "${BORG_UI_ENTITLEMENT:-}" ] || [ -n "${BORG_UI_LICENSE_KEY:-}" ]; then
  lic=$(curl -fsS "$(api system/info)" "${auth[@]}" \
         | python3 -c '
import sys, json
e = (json.load(sys.stdin).get("entitlement") or {})
print("%s\t%s\t%s\t%s\t%s" % (e.get("status") or "none", e.get("entitlement_id") or "",
                              "trial" if e.get("is_full_access") else "paid",
                              e.get("instance_id") or "", e.get("expires_at") or "")) ' 2>/dev/null) \
    || { echo "FATAL: could not read the current licensing state" >&2; exit 1; }
  lic_status=$(printf %s "$lic" | cut -f1)
  lic_entitlement=$(printf %s "$lic" | cut -f2)
  lic_kind=$(printf %s "$lic" | cut -f3)
  lic_instance=$(printf %s "$lic" | cut -f4)
  lic_expires=$(printf %s "$lic" | cut -f5)
  lic_desc="$lic_status"; [ "$lic_status" = "active" ] && lic_desc="active (${lic_kind})"
  echo "Licensing: status=${lic_desc}, instance_id=${lic_instance}"

  # Does the configured document belong to THIS instance? Anything else (missing,
  # malformed, issued for a different instance) falls through to the key.
  use_document=0
  if [ -n "${BORG_UI_ENTITLEMENT:-}" ]; then
    want=$(python3 -c '
import json, os, sys
d = json.loads(os.environ["BORG_UI_ENTITLEMENT"])
if not isinstance(d.get("payload"), dict) or not d.get("signature"):
    sys.exit("entitlement document needs a payload object and a signature")
print(json.dumps({k: d[k] for k in ("payload", "signature", "key_id") if d.get(k) is not None}))') \
      || { echo "FATAL: BORG_UI_ENTITLEMENT is not a valid entitlement document" >&2; exit 1; }
    want_id=$(printf %s "$want" | python3 -c 'import sys,json; print(json.load(sys.stdin)["payload"].get("entitlement_id") or "")')
    want_instance=$(printf %s "$want" | python3 -c 'import sys,json; print(json.load(sys.stdin)["payload"].get("instance_id") or "")')
    want_expires=$(printf %s "$want" | python3 -c 'import sys,json; print(json.load(sys.stdin)["payload"].get("expires_at") or "")')

    if [ -z "$lic_instance" ] || [ "$want_instance" = "$lic_instance" ]; then
      use_document=1
    elif [ -n "${BORG_UI_LICENSE_KEY:-}" ]; then
      echo "Entitlement was issued for instance ${want_instance}, this one is ${lic_instance}" \
           "— stale after a rebuild; falling back to the license key." >&2
    else
      echo "FATAL: entitlement was issued for instance ${want_instance}, this one is ${lic_instance}." >&2
      echo "       Have a document issued for this instance, or set borgUI.licensing.licenseKey." >&2
      exit 1
    fi
  fi

  if [ "$use_document" = 1 ]; then
    # Only import when there is something to gain. A live instance refreshes its
    # entitlement on its own (new entitlement_id, later expiry on a renewal), so
    # re-asserting a document kept in the release would roll that back.
    reason=import
    if [ "$lic_status" = "active" ] && [ -n "$want_id" ] && [ "$want_id" = "$lic_entitlement" ]; then
      reason=same
    elif [ "$lic_status" = "active" ] \
         && [ "$(LIC_EXP="$lic_expires" WANT_EXP="$want_expires" python3 -c '
import os
from datetime import datetime, timezone

def at(v):  # empty = no expiry = perpetual
    if not v:
        return datetime.max.replace(tzinfo=timezone.utc)
    d = datetime.fromisoformat(v.replace("Z", "+00:00"))
    return d if d.tzinfo else d.replace(tzinfo=timezone.utc)

try:
    print("yes" if at(os.environ["WANT_EXP"]) > at(os.environ["LIC_EXP"]) else "no")
except ValueError:
    print("no")  # unparsable: the live entitlement is working, keep it')" != "yes" ]; then
      reason=older
    fi

    if [ "$reason" = "same" ]; then
      echo "Entitlement ${want_id} already active — nothing to import."
    elif [ "$reason" = "older" ]; then
      echo "Instance holds entitlement ${lic_entitlement:-(none)} expiring ${lic_expires:-never}," \
           "not older than the configured document (${want_expires:-never}) — leaving it alone."
    else
      # Purely local (the server checks signature and instance_id), so a failure
      # here is a broken document — fail the release, don't warn.
      echo "Importing offline entitlement ${want_id:-(unnamed)} …"
      curl -fsS -X POST "$(api system/licensing/import)" "${auth[@]}" -H "Content-Type: application/json" \
        -d "${want}" >/dev/null \
        || { echo "FATAL: entitlement import rejected (signed with an unknown key?)" >&2; exit 1; }
      echo "Entitlement imported."
    fi
  elif [ "$lic_status" = "active" ] && [ "$lic_kind" = "paid" ]; then
    echo "Instance already carries a paid license — leaving it alone."
  else
    # Depends on a third-party service being reachable, so a failure must not
    # fail the release: the instance keeps whatever plan it has and the next
    # reconcile retries.
    echo "Activating license key against the activation service …"
    if curl -fsS -X POST "$(api system/licensing/activate)" "${auth[@]}" -H "Content-Type: application/json" \
         -d "$(python3 -c 'import json,os; print(json.dumps({"license_key": os.environ["BORG_UI_LICENSE_KEY"]}))')" >/dev/null
    then
      echo "License activated."
      # The freshly issued entitlement is bound to the CURRENT instance_id, so a
      # document kept in the release no longer matches it.
      [ -n "${BORG_UI_ENTITLEMENT:-}" ] && \
        echo "Re-export the entitlement (scripts/dump-entitlement.py) — the configured document is now stale."
    else
      echo "WARNING: license activation failed — leaving the current plan in place." >&2
    fi
  fi
fi

# --- 5) optional system SSH key import (the pods' key, staged on the server) --
# borg-ui uses the singleton SYSTEM key for all SSH ops (ssh:// repos, remote
# machines), so import the pods' key once. The private key path is read by the
# SERVER (its init container staged it); we only trigger the import via the API.
if [ -n "${BORG_UI_SSH_IMPORT_PRIVATE_PATH:-}" ]; then
  have=$(curl -fsS "$(api ssh-keys/system-key)" "${auth[@]}" \
          | python3 -c 'import sys,json; print("yes" if json.load(sys.stdin).get("exists") else "no")' 2>/dev/null || echo no)
  if [ "$have" = "yes" ]; then
    echo "System SSH key already present — skipping import."
  else
    echo "Importing system SSH key '${BORG_UI_SSH_IMPORT_NAME:-k8s-borg-system}' from ${BORG_UI_SSH_IMPORT_PRIVATE_PATH} …"
    ssh_payload=$(BORG_UI_SSH_IMPORT_NAME="${BORG_UI_SSH_IMPORT_NAME:-k8s-borg-system}" \
                  PRIV="${BORG_UI_SSH_IMPORT_PRIVATE_PATH}" \
                  PUB="${BORG_UI_SSH_IMPORT_PUBLIC_PATH:-${BORG_UI_SSH_IMPORT_PRIVATE_PATH}.pub}" python3 -c '
import json, os
print(json.dumps({"name": os.environ["BORG_UI_SSH_IMPORT_NAME"],
                  "private_key_path": os.environ["PRIV"],
                  "public_key_path": os.environ["PUB"]}))')
    curl -fsS -X POST "$(api ssh-keys/import)" "${auth[@]}" -H "Content-Type: application/json" \
      -d "${ssh_payload}" >/dev/null \
      || { echo "FATAL: system SSH key import failed (is the key staged at ${BORG_UI_SSH_IMPORT_PRIVATE_PATH} on the server?)" >&2; exit 1; }
    echo "System SSH key imported."
  fi
fi

# --- 6) optional remote machines (SSH connections; declarative, best-effort) --
# Each machine is registered via test-connection against the system key (no
# password — the public key must already be on the target). Idempotent: an
# existing connection for the same host is reused. Reachability failures are
# recorded on the connection (status) but do not fail the reconcile.
if [ -n "${BORG_UI_REMOTE_MACHINES:-}" ] && [ "${BORG_UI_REMOTE_MACHINES}" != "[]" ]; then
  key_id=$(curl -fsS "$(api ssh-keys/system-key)" "${auth[@]}" \
            | python3 -c 'import sys,json; d=json.load(sys.stdin); print((d.get("ssh_key") or {}).get("id") or "")' 2>/dev/null || echo "")
  [ -n "$key_id" ] || { echo "FATAL: remote machines requested but no system SSH key exists (set borgUI.systemSshKey.import)" >&2; exit 1; }
  echo "Reconciling remote machines against system key id ${key_id} …"
  printf '%s' "${BORG_UI_REMOTE_MACHINES}" \
    | python3 -c 'import sys,json
for m in json.load(sys.stdin):
    print("%s\t%s\t%s" % (m["host"], m["username"], m.get("port", 22)))' \
    | while IFS="$(printf '\t')" read -r host user port; do
        [ -n "$host" ] || continue
        body=$(HOST="$host" USER_="$user" PORT="$port" python3 -c '
import json, os
print(json.dumps({"host": os.environ["HOST"], "username": os.environ["USER_"], "port": int(os.environ["PORT"])}))')
        status=$(curl -sS -X POST "$(api ssh-keys/${key_id}/test-connection)" "${auth[@]}" \
                   -H "Content-Type: application/json" -d "${body}" \
                 | python3 -c 'import sys,json
try:
    d = json.load(sys.stdin); print((d.get("connection") or {}).get("status") or "unknown")
except Exception:
    print("error")' 2>/dev/null || echo "error")
        echo "  ${user}@${host}:${port} → ${status}"
      done
fi

# --- 7) publish the success marker so gated agent workloads can proceed -------
# Agents block on this ConfigMap (wait-for-reconcile init container), so a failure
# here must fail the Job (Flux/Helm --wait then fails the release), not warn.
if [ -n "${RECONCILE_STATUS_CONFIGMAP:-}" ] && [ -n "${RECONCILE_TOKEN:-}" ]; then
  publish_reconcile_marker || exit 1
  echo "Published reconcile marker '${RECONCILE_TOKEN}' to ${RECONCILE_STATUS_CONFIGMAP}."
fi

echo "Reconciliation complete."
