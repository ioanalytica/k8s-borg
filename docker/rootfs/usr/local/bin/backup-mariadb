#!/usr/bin/env bash
#
# backup-mariadb DEFAULTS_FILE — dump one MariaDB instance into
# $DB_BACKUP_LOCATION/<instance>/, <instance> being the file name without its
# extension:
#
#   <db>.sql                    one per database, for a selective restore
#   <instance>-full-dump.sql    every database (-A), the mysql schema with the
#                               users and grants included, for a complete one
#
# Both with routines, events and triggers. restore-mariadb reads these files.
#
# backup-mysql is this script under another name (a link): it dumps a MySQL
# instance the same way, with MySQL's own client from /opt/mysql/bin, because
# mariadb-dump writes the values of generated columns, which MySQL rejects on
# restore. Its dumps leave out the GTIDs (--set-gtid-purged=OFF): a restore
# brings back the data, it does not make the server a replica of the source,
# and the GTIDs of a second database restored into the same server would
# overlap with the first's. Each name refuses a server of the other engine.
#
# The dumps are uncompressed on purpose: a compressed stream differs from the
# first changed byte on, which defeats Borg's deduplication, and Borg
# compresses on its own.
#
# Any failure must FAIL the backup (rc>=2), never warn — a truncated or missing
# dump would otherwise be archived silently. pipefail and -E (the trap also
# fires inside functions) map every failure to rc>=2 through the ERR trap (in
# the borg-ui agent script contract rc 1 is only a non-fatal warning, which a
# dump failure is not).
set -Eeo pipefail
engine=${0##*/backup-}
# Reported once, by the script itself, not again by each subshell (a $(…))
# the failure ends.
# shellcheck disable=SC2154  # ec is assigned inside the trap body
trap 'ec=$?; [ "$ec" -lt 2 ] && ec=2; [ "$BASH_SUBSHELL" -gt 0 ] || echo "Error: $engine backup failed (rc=$ec)" >&2; exit "$ec"' ERR

# The dumps hold every row and the password hashes: nobody but the owner
# reads them, also not while they are being written.
umask 077

# shellcheck source=../lib/mysql-engine.sh
. "${BORG_LIB_DIR:-/usr/local/lib}/mysql-engine.sh"

defaults_file=$1

if [ -z "$defaults_file" ]; then
  echo "Error: No $engine config file specified!"
  exit 2
fi

if [ -z "$DB_BACKUP_LOCATION" ]; then
  echo "Error: environment variable DB_BACKUP_LOCATION not set!"
  exit 2
fi

xbase=${defaults_file##*/}
instance_name=${xbase%.*}

DB_BACKUP_DIR=${DB_BACKUP_LOCATION}/${instance_name}

require_server "$defaults_file"

mkdir -p "${DB_BACKUP_DIR}"

# dump_to FILE COMMAND… — run COMMAND with its output in FILE. It goes to a
# temporary file first, so a failing run leaves the previous dump intact.
dump_to() {
  local file=$1
  shift
  "$@" >"${file}.tmp"
  mv -f "${file}.tmp" "$file"
  chmod 600 "$file"
}

echo Dumping MySQL databases ...

# -N -B -r: one bare name per line, nothing escaped.
databases=$(sql_client "$defaults_file" -N -B -r -e "SHOW DATABASES")

while IFS= read -r db; do
  case "$db" in
    ""|information_schema|performance_schema|sys) continue ;;
  esac
  echo "Dumping database: $db -> ${DB_BACKUP_DIR}/$db.sql"
  dump_to "${DB_BACKUP_DIR}/$db.sql" \
    sql_dump "$defaults_file" -R -E --triggers --single-transaction --skip-dump-date --databases "$db"
done <<<"$databases"

echo "Dumping instance: $instance_name -> ${DB_BACKUP_DIR}/${instance_name}-full-dump.sql"
dump_to "${DB_BACKUP_DIR}/${instance_name}-full-dump.sql" \
  sql_dump "$defaults_file" -A -R -E --triggers --single-transaction --skip-dump-date

# Compressed dumps of the releases before, which would otherwise be archived
# with every backup from now on, and what an earlier failed run left half
# written. Removed only after a successful run.
rm -f "${DB_BACKUP_DIR}"/*.sql.gz "${DB_BACKUP_DIR}"/*.tmp

# end
