#!/usr/bin/env bash


# some helpers and error handling:
info() { printf "\n%s %s\n\n" "$( date )" "$*" >&2; }
trap 'echo $( date ) Prune interrupted >&2; exit 2' INT TERM

# Borg exit-code semantics (warning detection + combining), mode-agnostic.
# shellcheck source=../lib/borg-rc.sh
. "${BORG_LIB_DIR:-/usr/local/lib}/borg-rc.sh"

info "Pruning repository ..."

# retention policy (overridable via ENV, safe defaults)
KEEP_DAILY=${KEEP_DAILY:-7}
KEEP_WEEKLY=${KEEP_WEEKLY:-4}
KEEP_MONTHLY=${KEEP_MONTHLY:-6}

# prune/compact are named the same in borg1 and borg2, and both majors read the
# repo from BORG_REPO in the environment, so no positional repo is needed.
# borg 2.0.0b22 removed --keep-within (and --keep-last) in favour of --keep,
# which takes the same interval; borg 1 has no --keep. This is the one prune
# flag the two majors spell differently.
if [ "${BORG_VERSION:-1}" = "2" ]; then
  keep_recent=(--keep 24H)
else
  keep_recent=(--keep-within 24H)
fi

borg prune                     \
    --verbose                  \
    --list                     \
    --show-rc                  \
    "${keep_recent[@]}"        \
    --keep-daily    ${KEEP_DAILY}    \
    --keep-weekly   ${KEEP_WEEKLY}   \
    --keep-monthly  ${KEEP_MONTHLY}  \

prune_exit=$?

info "Compacting repository ..."

borg compact                   \
    --verbose                  \
    --show-rc                  \

compact_exit=$?

# Combine with borg precedence (error > warning > ok), NOT numeric max — a
# modern warning (100..127) outranks an error (2..99) numerically. See
# borg-rc.sh. A routine warning is tolerated (downgraded to 0), same as
# borg-backup.
global_exit="$(borg_rc_worst "$prune_exit" "$compact_exit")"

if borg_rc_is_warning "${global_exit}"; then
    info "Prune and/or Compact finished with a warning!"
    global_exit=0
elif [ "${global_exit}" -ne 0 ]; then
    info "Prune and/or Compact finished with an error!"
fi

exit ${global_exit}

# end
